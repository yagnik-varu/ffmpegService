# ── Server ───────────────────────────────────────────────
PORT=3001

# ── Google Drive ─────────────────────────────────────────
# Absolute path to the service-account JSON key file.
# In Docker you can mount it as a secret at /run/secrets/service_account.json
GOOGLE_SERVICE_ACCOUNT_JSON=/run/secrets/service_account.json

# The Drive folder where rendered videos will be uploaded.
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here

# ── OAuth2 for uploading to personal Google Drive ────────
# Required because Service Accounts do not have storage quota for uploads.
# Run: node scripts/get-oauth-token.js to generate these
GOOGLE_OAUTH_CLIENT_ID=your_oauth_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_oauth_client_secret_here
GOOGLE_OAUTH_REFRESH_TOKEN=your_oauth_refresh_token_here

# ── Local testing mode ────────────────────────────────
# Set to 'true' to skip Drive upload and save video to ./output/ instead
# This can also be overridden per-request by sending "skip_drive_upload": false in the JSON body.
SKIP_DRIVE_UPLOAD=true

# ── Video Codec (GPU / CPU) ───────────────────────────
# Use libx264 for CPU (default, recommended for cloud deployment)
# Use h264_nvenc for NVIDIA GPU hardware acceleration locally
FFMPEG_VCODEC=libx264
